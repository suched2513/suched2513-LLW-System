# =====================================================================
# ระบบบริหารการเงินและบัญชีสถานศึกษา - โรงเรียนละลมวิทยา
# Environment Configuration
# =====================================================================

APP_NAME="ระบบบริหารการเงินและบัญชีสถานศึกษา"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://llw.krusuched.com/financial
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th

# Database Configuration (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=llw_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Security & Sessions
APP_KEY=base64:GENERATE_YOUR_SECURE_RANDOM_KEY_HERE_32_BYTES
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CSRF_EXPIRY=7200

# School Information Defaults
SCHOOL_NAME="โรงเรียนละลมวิทยา"
SCHOOL_AFFILIATION="สังกัดสำนักงานเขตพื้นที่การศึกษามัธยมศึกษาบุรีรัมย์"
SCHOOL_ADDRESS="ตำบลละลม อำเภอไพรบึง จังหวัดศรีสะเกษ"
SCHOOL_PHONE="045-XXXXXX"
SCHOOL_TAX_ID="0994000XXXXXX"

# Storage & Upload Paths
STORAGE_PATH=storage
UPLOAD_MAX_FILESIZE_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,xlsx,xls,csv

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FINANCE_CHAT_ID=
