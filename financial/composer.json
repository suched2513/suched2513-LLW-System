{
    "name": "llw/school-financial-system",
    "description": "ระบบบริหารการเงินและบัญชีสถานศึกษา โรงเรียนละลมวิทยา",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lalompittayakhom School IT & Finance Team",
            "email": "admin@krusuched.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "vlucas/phpdotenv": "^5.5",
        "tecnickcom/tcpdf": "^6.6",
        "phpoffice/phpspreadsheet": "^1.29"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
